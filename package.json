{
  "name": "orbit-canister-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix canisters/frontend ci && cd canisters/backend && mops install",
    "dev": "npm --prefix canisters/frontend run dev",
    "build": "npm --prefix canisters/frontend run build",
    "test": "npm --prefix canisters/frontend test",
    "format": "npm --prefix canisters/frontend run format",
    "check:backend": "cd canisters/backend && mops check",
    "test:backend": "cd canisters/backend && mops test",
    "generate": "cd canisters/backend && mops generate candid backend",
    "test:integration": "npm --prefix canisters/frontend run test:integration"
  }
}
