type Visibility = 
 variant {
   allowed_viewers: vec principal;
   controllers;
   public;
 };
type Status = 
 record {
   cycles: nat;
   idle_cycles_burned_per_day: nat;
   memory_metrics:
    opt
     record {
       canister_history_size: nat;
       custom_sections_size: nat;
       global_memory_size: nat;
       log_memory_store_size: opt nat;
       snapshots_size: nat;
       stable_memory_size: nat;
       wasm_binary_size: nat;
       wasm_chunk_store_size: nat;
       wasm_memory_size: nat;
     };
   memory_size: nat;
   module_hash: opt blob;
   query_stats:
    record {
      num_calls_total: nat;
      num_instructions_total: nat;
      request_payload_bytes_total: nat;
      response_payload_bytes_total: nat;
    };
   ready_for_migration: opt bool;
   reserved_cycles: nat;
   settings: Settings;
   status: variant {
             running;
             stopped;
             stopping;
           };
   version: opt nat64;
 };
type Snapshot = 
 record {
   at: int;
   details: Status;
 };
type Settings = 
 record {
   compute_allocation: nat;
   controllers: vec principal;
   freezing_threshold: nat;
   log_memory_limit: opt nat;
   log_visibility: opt Visibility;
   memory_allocation: nat;
   reserved_cycles_limit: nat;
   snapshot_visibility: opt Visibility;
   status_visibility: opt Visibility;
   wasm_memory_limit: opt nat;
   wasm_memory_threshold: opt nat;
 };
type Result_2 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_1 = 
 variant {
   err: text;
   ok: Snapshot;
 };
type Result = 
 variant {
   err: text;
   ok;
 };
type Project = 
 record {
   canisterIds: vec principal;
   id: nat;
   name: text;
 };
type Point = 
 record {
   at: int;
   cycles: nat;
 };
type Entry = 
 record {
   addedAt: int;
   history: vec Point;
   id: principal;
   lastAttempt: int;
   lastError: opt text;
   name: text;
   snapshot: opt Snapshot;
 };
service : {
  addCanister: (id: principal, name: text) -> (Result);
  addCanisterInProject: (id: principal, name: text, projectId: opt nat) ->
   (Result);
  assignCanister: (id: principal, projectId: opt nat) -> (Result);
  createProject: (name: text) -> (Result_2);
  deleteProject: (id: nat) -> (Result);
  getBackendId: () -> (principal) query;
  listCanisters: () -> (vec Entry) query;
  listProjects: () -> (vec Project) query;
  refreshCanister: (id: principal) -> (Result_1);
  removeCanister: (id: principal) -> (Result);
  renameProject: (id: nat, name: text) -> (Result);
}
